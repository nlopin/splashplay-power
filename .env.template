# Stripe
# Secret API key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Publishable API key from https://dashboard.stripe.com/apikeys (exposed to the browser)
PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET_KEY=

# Calendly
# Personal access token from https://calendly.com/integrations/api_webhooks
CALENDLY_TOKEN=
