---
import Layout from "@/layouts/Layout.astro";
import { getPageTranslations, isSupportedLanguage } from "@/utils/i18n";
import { getAvailability } from "@/services/availability";
import BookingForm from "@/components/booking/BookingForm.tsx";
import type { EventType } from "@/components/booking/types";

export const prerender = false;

const { lang } = Astro.params;

if (!lang || !isSupportedLanguage(lang)) {
    return Astro.redirect("/404");
}

const eventType: EventType = "friends";
const translations = getPageTranslations(lang, "book");

const availability = await getAvailability(eventType);
---

<Layout>
    <BookingForm
        translations={translations}
        availability={availability}
        lang={lang}
        eventType={eventType}
        client:load
    />
</Layout>

<style is:global>
    /* Friends-specific styles */
    .options-grid.vertical {
        grid-template-columns: 1fr;
        max-width: 500px;
        margin: 0;
        gap: 20px;
    }

    .options-grid-unified {
        grid-template-columns:
            max-content max-content minmax(70px, max-content)
            max-content;
    }

    /* Friends Options Styles */
    .friends-options {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .number-input-container {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: flex-start;
        margin-top: 0;
    }

    .number-input {
        width: 100%;
        border: 1px solid var(--border-color);
        background: var(--white);
        border-radius: 6px;
        font-size: var(--font-base);
        text-align: right;
        color: var(--dark-text);
        padding: 6px 8px;
        outline: none;
    }

    .number-input-btn {
        width: 32px;
        height: 32px;
        border: 1px solid var(--border-color);
        background: var(--white);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--dark-text);
        font-size: var(--font-lg);
        transition: all 0.2s;
    }

    .number-input-btn:hover:not(:disabled) {
        background: var(--purple-light);
        border-color: var(--purple);
    }

    .number-input-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .option-card {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 12px 0;
        background-color: transparent;
        border: none;
        cursor: default;
        position: relative;
    }

    .option-card:hover {
        background-color: transparent;
    }

    .option-card.selected {
        background-color: transparent;
        border: none;
        padding: 16px 0;
    }

    .option-input {
        margin-right: 12px;
        width: 20px;
        height: 20px;
        accent-color: var(--purple);
    }

    .option-card.selected .option-input {
        accent-color: var(--purple);
    }

    .option-content {
        display: flex;
        align-items: center;
        width: 100%;
        gap: 12px;
    }

    .option-label {
        color: var(--dark-text);
        transition: color 0.2s;
        min-width: 80px;
        font-weight: 500;
    }

    .option-label-with-hint {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .option-hint {
        font-size: 0.8em;
        color: var(--dark-text);
        opacity: 0.75;
    }

    .option-price {
        font-size: var(--font-lg);
        font-weight: bold;
        color: var(--purple);
        transition: color 0.2s;
    }

    .canvas-type-selector {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .canvas-type-label {
        font-weight: 500;
        color: var(--dark-text);
    }

    .canvas-type-options {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .canvas-type-option {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 1rem;
        border: 2px solid var(--border-color, #ddd);
        border-radius: 8px;
        cursor: pointer;
        font-size: var(--font-sm);
        color: var(--dark-text);
        transition: all 0.2s;
        background: var(--white);
    }

    .canvas-type-option input[type="radio"] {
        accent-color: var(--purple);
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .canvas-type-option--selected {
        border-color: var(--purple);
        background: var(--purple);
        color: var(--white);
        font-weight: 600;
    }

    .canvas-type-option--selected input[type="radio"] {
        accent-color: var(--white);
    }

    .canvas-type-option:hover:not(.canvas-type-option--selected) {
        border-color: var(--purple);
    }

    .option-label--disabled {
        opacity: 0.45;
    }

    .number-input--disabled {
        opacity: 0.45;
        background: #f5f5f5;
        cursor: not-allowed;
    }
</style>
