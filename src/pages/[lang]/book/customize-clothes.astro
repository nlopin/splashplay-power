---
import Layout from "@/layouts/Layout.astro";
import { getPageTranslations, isSupportedLanguage } from "@/utils/i18n";
import { getAvailability } from "@/services/availability";
import BookingForm from "@/components/booking/BookingForm.tsx";
import type { EventType } from "@/components/booking/types";

export const prerender = false;

const { lang } = Astro.params;

if (!lang || !isSupportedLanguage(lang)) {
    return Astro.redirect("/404");
}

const eventType: EventType = "customize_clothes";
const translations = getPageTranslations(lang, "book");

const availability = await getAvailability(eventType);
---

<Layout>
    <BookingForm
        translations={translations}
        availability={availability}
        lang={lang}
        eventType={eventType}
        client:load
    />
</Layout>

<style is:global>
    .options-grid-unified {
        grid-template-columns:
            max-content max-content minmax(70px, max-content)
            max-content;
    }

    .paint-options {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .number-input {
        width: 100%;
        border: 1px solid var(--border-color);
        background: var(--white);
        border-radius: 6px;
        font-size: var(--font-base);
        text-align: right;
        color: var(--dark-text);
        padding: 6px 8px;
        outline: none;
    }

    .option-label {
        color: var(--dark-text);
        transition: color 0.2s;
        min-width: 80px;
        font-weight: 500;
    }

    .option-label-with-hint {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .option-hint {
        font-size: 0.8em;
        color: var(--dark-text);
        opacity: 0.75;
        max-width: 180px;
        line-height: 1.3;
    }
</style>
