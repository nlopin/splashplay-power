---
import Layout from "@/layouts/Layout.astro";
import { getPageTranslations, isSupportedLanguage } from "@/utils/i18n";
import { getAvailability } from "@/services/availability";
import BookingForm from "@/components/booking/BookingForm.tsx";
import type { EventType } from "@/components/booking/types";

export const prerender = false;

const { lang } = Astro.params;

if (!lang || !isSupportedLanguage(lang)) {
    return Astro.redirect("/404");
}

const eventType: EventType = "couples";
const translations = getPageTranslations(lang, "book");

const availability = await getAvailability(eventType);
---

<Layout>
    <BookingForm
        translations={translations}
        availability={availability}
        lang={lang}
        eventType={eventType}
        client:load
    />
</Layout>

<style is:global>
    .couples-options-grid {
        display: flex;
        flex-wrap: nowrap;
        gap: 16px;
        justify-content: flex-start;

        --card-shift: -4px;
    }

    .couples-options-section {
        margin-bottom: 16px;
    }

    .couples-option-card {
        cursor: pointer;
        min-width: 0;
        flex: 1 1 0;
        border: 2px solid #e0e0e0;
        border-radius: 16px;
        padding: 16px;
        background-color: white;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        display: flex;
        flex-direction: column;
        gap: 16px;
        align-items: center;
        position: relative;
        transition: all 0.2s ease;
    }

    .couples-option-card:hover {
        transform: translateY(var(--card-shift));
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
        border-color: #d0d0d0;
    }

    .couples-option-card.selected {
        border: 2px solid var(--purple);
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
        transform: translateY(var(--card-shift));
    }

    .couples-option-image-container {
        width: 100%;
        max-width: 210px;
        aspect-ratio: 9 / 16;
        overflow: hidden;
        border-radius: 12px;
        background-color: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 260px;
    }

    .couples-option-card.selected .couples-option-image-container {
        border: none;
        box-shadow: none;
    }

    .couples-option-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .couples-option-card .option-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-align: center;
    }

    .couples-option-card .option-label {
        font-size: var(--font-md);
        font-weight: 700;
        line-height: 1.2;
        color: #1a1a1a;
        text-align: center;
    }

    .couples-option-card .option-price {
        font-size: var(--font-base);
        font-weight: 600;
        background-color: #f0f0f0;
        padding: 6px 16px;
        border-radius: 20px;
        color: #333;
    }

    .couples-option-card.selected .option-price {
        background-color: var(--purple);
        color: white;
    }

    .couples-option-card.selected .price-original {
        color: rgba(255, 255, 255, 0.65);
    }

    .couples-option-card.selected .discount-badge {
        background-color: rgba(255, 255, 255, 0.25);
        color: white;
    }

    .popular-badge {
        position: absolute;
        top: -12px;
        right: -12px;
        background-color: var(--orange);
        color: white;
        font-size: var(--font-xs);
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        z-index: 1;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    @media (max-width: 640px) {
        .couples-options-grid {
            flex-wrap: wrap;
        }

        .couples-option-card {
            flex: 1 1 calc(50% - 8px);
            width: auto;
            padding: 12px;
            gap: 12px;
        }

        .couples-option-card .option-input {
            top: 8px;
            left: 8px;
            width: 18px;
            height: 18px;
        }

        .couples-option-card .option-input:checked::after {
            width: 6px;
            height: 6px;
        }

        .couples-option-image-container {
            aspect-ratio: 9 / 16;
        }

        .couples-option-card .option-label {
            font-size: var(--font-base);
        }

        .couples-option-card .option-price {
            font-size: var(--font-sm);
            padding: 4px 12px;
        }

        .popular-badge {
            top: -10px;
            right: -8px;
            font-size: var(--font-xs);
            padding: 3px 10px;
        }
    }

    .couples-options-title {
        width: 100%;
        text-align: left;
        font-size: var(--font-xl);
        color: #1a1a1a;
    }

    /* Style radio button */
    .couples-option-card .option-input {
        position: absolute;
        top: 12px;
        left: 12px;
        width: 20px;
        height: 20px;
        margin: 0;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        border: 2px solid #d0d0d0;
        border-radius: 50%;
        background-color: white;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .couples-option-card .option-input:checked {
        border-color: var(--purple);
        background-color: var(--purple);
    }

    .couples-option-card .option-input:checked::after {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: white;
        display: block;
    }

    .couples-option-card:hover .option-input {
        border-color: var(--purple);
    }

    /* Other existing styles */
    .options-grid-unified {
        grid-template-columns: max-content max-content max-content max-content;
    }

    .number-input-container {
        margin-top: 12px;
    }

    .number-input {
        width: 50px;
        height: 28px;
        text-align: left;
        border: none;
        background: transparent;
        font-size: var(--font-base);
        font-weight: bold;
        color: var(--dark-text);
        padding: 0;
        outline: none;
    }

    .option-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 16px 0;
        background-color: transparent;
        border: none;
        cursor: default;
        position: relative;
    }

    .option-card:hover {
        background-color: transparent;
    }

    .option-card.selected {
        background-color: transparent;
        border: none;
        padding: 16px 0;
    }

    .total-price-value {
        font-size: var(--font-md);
        font-weight: bold;
        color: var(--purple);
    }

    .total-price-text {
        font-size: var(--font-md);
        margin-top: 8px !important;
    }

    .canvas-type-selector {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .canvas-type-label {
        font-weight: 500;
        color: var(--dark-text);
    }

    .canvas-type-options {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .canvas-type-option {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 1rem;
        border: 2px solid var(--border-color, #ddd);
        border-radius: 8px;
        cursor: pointer;
        font-size: var(--font-sm);
        color: var(--dark-text);
        transition: all 0.2s;
        background: var(--white);
    }

    .canvas-type-option input[type="radio"] {
        accent-color: var(--purple);
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .canvas-type-option--selected {
        border-color: var(--purple);
        background: var(--purple);
        color: var(--white);
        font-weight: 600;
    }

    .canvas-type-option--selected input[type="radio"] {
        accent-color: var(--white);
    }

    .canvas-type-option:hover:not(.canvas-type-option--selected) {
        border-color: var(--purple);
    }
</style>
