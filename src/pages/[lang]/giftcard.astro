---
import SimpleLayout from "@/layouts/SimpleLayout.astro";
import GiftCardWidget from "@/components/GiftCardWidget.astro";
import {
    languages,
    type Language,
    getPageTranslations,
    languagePrefixes,
} from "../../utils/i18n";

export async function getStaticPaths() {
    return languages.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Language };
const translations = getPageTranslations(lang, "giftcard");
const homeHref = languagePrefixes[lang] || "/";

const languageMap: Record<Language, string> = {
    es: "es-ES",
    en: "en-GB",
    ca: "es-ES",
    fr: "fr-FR",
};

const giftUpLanguage = languageMap[lang];
---

<SimpleLayout title={translations.title} description={translations.meta_description} homeHref={homeHref}>
    <h1 class="giftcard-title">{translations.h1}</h1>
    <p class="giftcard-intro">{translations.intro}</p>
    <ul class="giftcard-benefits">
        {
            translations.benefits.map((benefit) => {
                const [icon, ...words] = benefit.split(" ");
                return (
                    <li>
                        <span aria-hidden="true">{icon}</span>
                        <span>{words.join(" ")}</span>
                    </li>
                );
            })
        }
    </ul>
    <p class="giftcard-popular" set:html={translations.popular} />
    <GiftCardWidget language={giftUpLanguage} />
</SimpleLayout>

<style>
    .giftcard-title {
        max-width: 700px;
        line-height: 1.2;
    }

    .giftcard-intro,
    .giftcard-benefits,
    .giftcard-popular {
        width: 100%;
        max-width: 500px;
        text-align: left;
        font-size: var(--font-base);
        color: var(--dark-text);
        line-height: 1.6;
    }

    .giftcard-intro {
        margin: 0 auto 1.5rem;
    }

    .giftcard-benefits {
        margin: 0 auto 1.5rem;
        padding: 0;
        list-style: none;
    }

    .giftcard-benefits li {
        display: flex;
        gap: 0.5em;
    }

    .giftcard-popular {
        margin: 0 auto 2rem;
    }
</style>
