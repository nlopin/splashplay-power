---
import SimpleLayout from "@/layouts/SimpleLayout.astro";
import GiftCardWidget from "@/components/GiftCardWidget.astro";
import {
    languages,
    type Language,
    getPageTranslations,
    languagePrefixes,
} from "../../utils/i18n";

export async function getStaticPaths() {
    return languages.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Language };
const translations = getPageTranslations(lang, "giftcard");
const homeHref = languagePrefixes[lang] || "/";

const languageMap: Record<Language, string> = {
    es: "es-ES",
    en: "en-GB",
    ca: "es-ES",
};

const giftUpLanguage = languageMap[lang];
---

<SimpleLayout title={translations.title} homeHref={homeHref}>
    <GiftCardWidget language={giftUpLanguage} />
</SimpleLayout>
