---
import {
    createAstroTranslator,
    getCurrentLanguage,
    getLocalizedPath,
} from "../../utils/i18n";
import { isActivityHidden } from "../../config/activities";
import { DISCOUNT_BADGE_ROW_SPAN, type OptCell, type PricingRow } from "../../utils/pricingTable";
import DiscountWeekdayBadge from "../DiscountWeekdayBadge.astro";
import DiscountWeekdayNote from "../DiscountWeekdayNote.astro";
import smallCanvas from "../../assets/img/30x40_compartido.jpg";
import largeCanvas from "../../assets/img/60x80_compartido.jpg";
import twoCanvases from "../../assets/img/30x40_2individuales.jpg";
import clothing1 from "../../assets/photo/clothing/clothing1-074c0620-2ca8-40fd-b3b0-c18bdfb1199c.png";
import clothing2 from "../../assets/photo/clothing/clothing2-71fec5c8-abb0-43c7-b790-5d926bd3b104.png";
import clothing3 from "../../assets/photo/clothing/clothing3-f0f01b38-f4ca-4930-9a3b-163e191923ce.png";
import clothing4 from "../../assets/photo/clothing/clothing4-848c4160-7c5c-43f9-83ce-2ce5febb0bb6.png";

const t = createAstroTranslator(Astro.currentLocale, "friends");
const tMain = createAstroTranslator(Astro.currentLocale, "main");
const tHome = createAstroTranslator(Astro.currentLocale, "home");
const lang = getCurrentLanguage(Astro.currentLocale);

const clothingPhotos = [clothing1, clothing2, clothing3, clothing4];

const activity2Columns = [
    { headerKey: "activity_2_table_1_header", priceKey: "activity_2_table_1_price", descKey: "activity_2_table_1_desc" },
    { headerKey: "activity_2_table_2_header", priceKey: "activity_2_table_2_price", descKey: "activity_2_table_2_desc" },
    { headerKey: "activity_2_table_3_header", priceKey: "activity_2_table_3_price", descKey: "activity_2_table_3_desc" },
];

const activity3Columns = [
    { headerKey: "activity_3_table_1_header", priceKey: "activity_3_table_1_price", descKey: "activity_3_table_1_desc" },
    { headerKey: "activity_3_table_2_header", priceKey: "activity_3_table_2_price", descKey: "activity_3_table_2_desc" },
    { headerKey: "activity_3_table_3_header", priceKey: "activity_3_table_3_price", descKey: "activity_3_table_3_desc" },
];

// Table: columns = group sizes (2,3,4,5,6 people), rows = canvas count options
// null means this option is not available for that group
const activity1Groups = [
    { headerKey: "pt_group_2_header", subheaderKey: "pt_group_2_sub" },
    { headerKey: "pt_group_3_header", subheaderKey: "pt_group_3_sub" },
    { headerKey: "pt_group_4_header", subheaderKey: "pt_group_4_sub" },
    { headerKey: "pt_group_5_header", subheaderKey: "pt_group_5_sub" },
    { headerKey: "pt_group_6_header", subheaderKey: "pt_group_6_sub" },
];

// Each row: one canvas-count option. Per group: [labelKey, priceKey] or null if unavailable.
const activity1Rows: PricingRow[] = [
    { cells: [
        { labelKey: "pt_2_opt1", priceKey: "pt_2_opt1_pp" },
        { labelKey: "pt_3_opt1", priceKey: "pt_3_opt1_pp" },
        null,
        null,
        null,
    ]},
    { cells: [
        { labelKey: "pt_2_opt2", priceKey: "pt_2_opt2_pp" },
        { labelKey: "pt_3_opt2", priceKey: "pt_3_opt2_pp" },
        { labelKey: "pt_4_opt2", priceKey: "pt_4_opt2_pp" },
        null,
        null,
    ]},
    { cells: [
        null,
        { labelKey: "pt_3_opt3", priceKey: "pt_3_opt3_pp" },
        { labelKey: "pt_4_opt3", priceKey: "pt_4_opt3_pp" },
        { labelKey: "pt_5_opt3", priceKey: "pt_5_opt3_pp" },
        { labelKey: "pt_6_opt3", priceKey: "pt_6_opt3_pp" },
    ]},
    {
        // Discount badge sits in this row's empty first column.
        discountBadgeCol: 0,
        cells: [
            null,
            null,
            { labelKey: "pt_4_opt4", priceKey: "pt_4_opt4_pp" },
            { labelKey: "pt_5_opt4", priceKey: "pt_5_opt4_pp" },
            { labelKey: "pt_6_opt4", priceKey: "pt_6_opt4_pp" },
        ],
    },
    { cells: [
        null,
        null,
        null,
        { labelKey: "pt_5_opt5", priceKey: "pt_5_opt5_pp" },
        { labelKey: "pt_6_opt5", priceKey: "pt_6_opt5_pp" },
    ]},
    { cells: [
        null,
        null,
        null,
        null,
        { labelKey: "pt_6_opt6", priceKey: "pt_6_opt6_pp" },
    ]},
];

// Big canvas rows (always last, separator above). 1 guest is not a table column.
const activity1BigRows: OptCell[][] = [
    [
        { labelKey: "pt_2_big", priceKey: "pt_2_big_pp" },
        { labelKey: "pt_3_big", priceKey: "pt_3_big_pp" },
        { labelKey: "pt_4_big", priceKey: "pt_4_big_pp" },
        { labelKey: "pt_5_big", priceKey: "pt_5_big_pp" },
        { labelKey: "pt_6_big", priceKey: "pt_6_big_pp" },
    ],
    [
        { labelKey: "pt_2_two_big", priceKey: "pt_2_two_big_pp" },
        { labelKey: "pt_3_two_big", priceKey: "pt_3_two_big_pp" },
        { labelKey: "pt_4_two_big", priceKey: "pt_4_two_big_pp" },
        { labelKey: "pt_5_two_big", priceKey: "pt_5_two_big_pp" },
        { labelKey: "pt_6_two_big", priceKey: "pt_6_two_big_pp" },
    ],
];

// For mobile cards, reconstruct per-group options list
const activity1GroupsWithOptions = activity1Groups.map((group, gi) => ({
    ...group,
    options: activity1Rows
        .map((row) => row.cells[gi])
        .filter(Boolean) as { labelKey: string; priceKey: string }[],
    bigCanvasOptions: activity1BigRows.map(
        (row) => row[gi] as { labelKey: string; priceKey: string },
    ),
}));

const bookBaseUrl = getLocalizedPath("/book/friends", lang);
const bookThrowPaintUrl = getLocalizedPath("/book/throw-paint", lang);
const bookCustomizeClothesUrl = getLocalizedPath("/book/customize-clothes", lang);

function headerWithHighlightedNum(text: string) {
    const match = text.match(/^(\d+)(.*)$/);
    if (match) {
        return { num: match[1], rest: match[2] };
    }
    return null;
}

function renderHeaderHtml(raw: string) {
    const withSize = raw.replace(/(\d+[x×]\d+)/g, '<span class="header-size">$1</span>');
    const parsed = headerWithHighlightedNum(withSize);
    return parsed ? `<span class="header-num">${parsed.num}</span>${parsed.rest}` : withSize;
}

// Splits "1 canvas — 75€" into { canvasLabel: "1 canvas", price: "75€" }
function parseOptLabel(text: string): { canvasLabel: string; price: string } | null {
    const match = text.match(/^(.+?)\s*[—–-]\s*(\S+€)$/);
    if (match) {
        return { canvasLabel: match[1].trim(), price: match[2].trim() };
    }
    return null;
}
---

<section id="pricing" class="prices prices--friends" data-menu-title={tMain("nav_pricing")}>
    <div class="container">
        <h2 class="section-title">{t("pricing_title")}</h2>

        <!-- Activity 1: Create your abstract masterpiece -->
        <div class="pricing-activity pricing-activity--wide">
            <h3 class="pricing-activity-title">
                {t("activity_1_title")}
                <span class="pricing-activity-meta">{t("activity_1_meta")}</span>
            </h3>
            <p class="pricing-activity-description" set:html={t("pricing_activity1_description")} />
            <div class="discount-banner-slot">
                <DiscountWeekdayBadge shape="banner" namespace="friends" />
            </div>
            <div class="discount-note-slot discount-note-slot--before-table">
                <DiscountWeekdayNote namespace="friends" href={bookBaseUrl} />
            </div>
            <!-- Mobile: one card per group size -->
            <div class="pricing-cards-mobile">
                {activity1GroupsWithOptions.map((group) => (
                    <div class="pricing-card-mobile pricing-card-mobile--group">
                        <div class="pricing-card-mobile-header">{t(group.headerKey)}</div>
                        <div class="pricing-card-mobile-subheader">{t(group.subheaderKey)}</div>
                        <ul class="pricing-card-mobile-options">
                            {group.options.map((opt) => {
                                const parsed = parseOptLabel(t(opt.labelKey));
                                return (
                                    <li>
                                        <span class="opt-row-main">
                                            <span class="opt-canvas-label">{parsed ? parsed.canvasLabel : t(opt.labelKey)}</span>
                                            {parsed && <span class="opt-canvas-price">{parsed.price}</span>}
                                        </span>
                                        <span class="opt-price">{t(opt.priceKey)}</span>
                                    </li>
                                );
                            })}
                            <li class="pricing-card-mobile-big-header">{t("pricing_big_canvas_section_title")}</li>
                            {group.bigCanvasOptions.map((opt) => {
                                const parsed = parseOptLabel(t(opt.labelKey));
                                return (
                                    <li>
                                        <span class="opt-row-main">
                                            <span class="opt-canvas-label">{parsed ? parsed.canvasLabel : t(opt.labelKey)}</span>
                                            {parsed && <span class="opt-canvas-price">{parsed.price}</span>}
                                        </span>
                                        <span class="opt-price">{t(opt.priceKey)}</span>
                                    </li>
                                );
                            })}
                        </ul>
                        <a href={bookBaseUrl} class="pricing-btn pricing-btn--mobile">{t("cta_book_button")}</a>
                    </div>
                ))}
            </div>
            <!-- Desktop table: columns = group sizes, rows = canvas options -->
            <div class="pricing-table-wrap pricing-table-wrap--groups">
                <table class="pricing-table pricing-table--groups">
                    <thead>
                        <tr>
                            {activity1Groups.map((group, groupIndex) => (
                                <th
                                    scope="col"
                                    class:list={["pricing-table-col", groupIndex % 2 === 0 ? "pricing-table-col--purple" : "pricing-table-col--yellow"]}
                                >
                                    <div class="th-header">{t(group.headerKey)}</div>
                                    <div class="th-sub">{t(group.subheaderKey)}</div>
                                </th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {activity1Rows.map((row, rowIndex) => (
                            <tr>
                                {row.cells.map((cell, cellIndex) => {
                                    const colClass = cellIndex % 2 === 0 ? "pricing-table-col--purple" : "pricing-table-col--yellow";
                                    if (!cell) {
                                        if (row.discountBadgeCol === cellIndex) {
                                            return (
                                                <td class:list={["td-discount-badge-host", "pricing-table-col", colClass]} rowspan={DISCOUNT_BADGE_ROW_SPAN}>
                                                    <span class="table-badge-slot">
                                                        <DiscountWeekdayBadge shape="circle" namespace="friends" />
                                                    </span>
                                                </td>
                                            );
                                        }
                                        // Skip cells hidden under a badge spanning down from an earlier row.
                                        for (let s = 1; s < DISCOUNT_BADGE_ROW_SPAN; s++) {
                                            if (activity1Rows[rowIndex - s]?.discountBadgeCol === cellIndex) return null;
                                        }
                                        return <td class:list={["td-empty", "pricing-table-col", colClass]} />;
                                    }
                                    const parsed = parseOptLabel(t(cell.labelKey));
                                    return (
                                        <td class:list={["pricing-table-col", colClass]}>
                                            <span class="opt-row-main">
                                                <span class="opt-canvas-label">{parsed ? parsed.canvasLabel : t(cell.labelKey)}</span>
                                                {parsed && <span class="opt-canvas-price">{parsed.price}</span>}
                                            </span>
                                            <span class="opt-price">{t(cell.priceKey)}</span>
                                        </td>
                                    );
                                })}
                            </tr>
                        ))}
                        <tr class="tr-big-canvas-header">
                            <td colspan={activity1Groups.length}>{t("pricing_big_canvas_section_title")}</td>
                        </tr>
                        {activity1BigRows.map((row) => (
                            <tr class="tr-big-canvas">
                                {row.map((cell, cellIndex) => {
                                    const colClass = cellIndex % 2 === 0 ? "pricing-table-col--purple" : "pricing-table-col--yellow";
                                    if (!cell) return <td class:list={["td-empty", "pricing-table-col", colClass]} />;
                                    const parsed = parseOptLabel(t(cell.labelKey));
                                    return (
                                        <td class:list={["pricing-table-col", colClass]}>
                                            <span class="opt-row-main">
                                                <span class="opt-canvas-label">{parsed ? parsed.canvasLabel : t(cell.labelKey)}</span>
                                                {parsed && <span class="opt-canvas-price">{parsed.price}</span>}
                                            </span>
                                            <span class="opt-price">{t(cell.priceKey)}</span>
                                        </td>
                                    );
                                })}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <div class="pricing-table-cta">
                <a href={bookBaseUrl} class="pricing-btn pricing-btn--standalone">{t("cta_book_button")}</a>
            </div>
            <h4 class="canvas-reference-title">{t("canvas_size_reference")}</h4>
            <div class="canvas-examples">
                <div class="canvas-example">
                    <span class="canvas-example-img-wrap">
                        <img src={smallCanvas.src} alt="30×40 cm" class="canvas-example-image" />
                    </span>
                    <span class="canvas-example-caption">Standard 30×40 cm</span>
                </div>
                <div class="canvas-example">
                    <span class="canvas-example-img-wrap">
                        <img src={largeCanvas.src} alt="60x90 cm" class="canvas-example-image" />
                    </span>
                    <span class="canvas-example-caption">Big 60x90 cm</span>
                </div>
                <div class="canvas-example">
                    <span class="canvas-example-img-wrap">
                        <img src={twoCanvases.src} alt="2× 30×40 cm" class="canvas-example-image" />
                    </span>
                    <span class="canvas-example-caption">2 standard 30×40 cm</span>
                </div>
            </div>
        </div>

        {!isActivityHidden("throw_paint") && (
        <div class="pricing-activity">
            <h3 class="pricing-activity-title">
                {tHome("activity_2_title")}
                <span class="pricing-activity-meta">{t("activity_2_meta")}</span>
            </h3>
            <p class="pricing-activity-description">{t("activity_2_description")}</p>
            <div class="pricing-cards-mobile pricing-cards-mobile--activity2">
                {activity2Columns.map((col) => (
                    <div class="pricing-card-mobile">
                        <div class="pricing-card-mobile-header">{t(col.headerKey)}</div>
                        <div class="pricing-card-mobile-price">{t(col.priceKey)}</div>
                        <a href={bookThrowPaintUrl} class="pricing-btn pricing-btn--mobile">{t("cta_book_button")}</a>
                    </div>
                ))}
            </div>
            <div class="pricing-table-wrap pricing-table-wrap--simple">
                <table class="pricing-table pricing-table--simple">
                    <thead>
                        <tr>
                            {activity2Columns.map((col) => (
                                <th scope="col">{t(col.headerKey)}</th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="pricing-row-price">
                            {activity2Columns.map((col) => (
                                <td data-label={t(col.headerKey)} class="price-total">{t(col.priceKey)}</td>
                            ))}
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="pricing-table-cta">
                <a href={bookThrowPaintUrl} class="pricing-btn pricing-btn--standalone">{t("cta_book_button")}</a>
            </div>
        </div>
        )}

        {!isActivityHidden("customize_clothes") && (
        <div class="pricing-activity">
            <h3 class="pricing-activity-title">
                {tHome("activity_3_title")}
                <span class="pricing-activity-meta">{t("activity_3_meta")}</span>
            </h3>
            <p class="pricing-activity-description">{t("activity_3_description")}</p>
            <div class="clothing-photos">
                {clothingPhotos.map((img) => (
                    <span class="clothing-photo-wrap">
                        <img src={img.src} alt="Customized clothing" class="clothing-photo" />
                    </span>
                ))}
            </div>
            <div class="pricing-cards-mobile pricing-cards-mobile--activity3">
                {activity3Columns.map((col) => (
                    <div class="pricing-card-mobile">
                        <div class="pricing-card-mobile-header">{t(col.headerKey)}</div>
                        <div class="pricing-card-mobile-price">{t(col.priceKey)}</div>
                        <a href={bookCustomizeClothesUrl} class="pricing-btn pricing-btn--mobile">{t("cta_book_button")}</a>
                    </div>
                ))}
            </div>
            <div class="pricing-table-wrap pricing-table-wrap--simple">
                <table class="pricing-table pricing-table--simple">
                    <thead>
                        <tr>
                            {activity3Columns.map((col) => (
                                <th scope="col">{t(col.headerKey)}</th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="pricing-row-price">
                            {activity3Columns.map((col) => (
                                <td data-label={t(col.headerKey)} class="price-total">{t(col.priceKey)}</td>
                            ))}
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="pricing-table-cta">
                <a href={bookCustomizeClothesUrl} class="pricing-btn pricing-btn--standalone">{t("cta_book_button")}</a>
            </div>
        </div>
        )}
    </div>
</section>

<style>
    .prices--friends {
        padding: 3rem 0;
        background-color: var(--white);
        scroll-margin-top: 60px;
    }

    .prices--friends .section-title {
        text-align: center;
    }

    .pricing-activity {
        max-width: 900px;
        margin: 0 auto 3rem;
        text-align: center;
    }

    .pricing-activity:last-child {
        margin-bottom: 0;
    }

    .pricing-activity--wide {
        max-width: 1100px;
    }

    .pricing-activity-title {
        font-size: var(--font-xl);
        color: var(--purple);
        font-weight: 700;
        margin: 0 0 1rem;
        line-height: 1.3;
    }

    .pricing-activity-meta {
        display: inline;
        font-size: var(--font-base);
        font-weight: 700;
        color: var(--dark-text);
        margin-left: 0.5rem;
    }

    .pricing-activity-description {
        font-size: var(--font-base);
        color: var(--dark-text);
        line-height: 1.6;
        margin: 0 0 1.5rem;
    }

    .clothing-photos {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .clothing-photo-wrap {
        display: block;
        border-radius: 12px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .clothing-photo {
        display: block;
        width: 100%;
        max-width: 140px;
        height: auto;
        object-fit: contain;
        vertical-align: top;
    }

    @media (max-width: 600px) {
        .clothing-photo {
            max-width: 100px;
        }
    }

    .pricing-activity-brief {
        font-size: var(--font-base);
        color: var(--dark-text);
        line-height: 1.6;
        margin: 0 0 1rem;
    }

    .canvas-reference-title {
        font-size: var(--font-sm);
        font-weight: 600;
        color: var(--purple);
        margin: 2rem 0 1rem;
        text-align: center;
    }

    .canvas-examples {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        max-width: 560px;
        margin: 0 auto 1.5rem;
    }

    .canvas-example {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .canvas-example-img-wrap {
        display: block;
        border-radius: 12px;
        overflow: hidden;
    }

    .canvas-example-image {
        display: block;
        width: 100%;
        height: auto;
        vertical-align: top;
    }

    .canvas-example-caption {
        font-size: var(--font-xs);
        color: var(--purple);
        font-weight: 600;
        margin-top: 0.5rem;
    }

    @media (max-width: 600px) {
        .canvas-examples {
            grid-template-columns: 1fr;
            max-width: 280px;
        }
    }

    .pricing-cards-mobile {
        display: none;
    }

    .pricing-table-wrap {
        overflow-x: auto;
        border-radius: 12px;
        border: 1px solid rgba(102, 51, 153, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }

    .pricing-table {
        width: 100%;
        min-width: 600px;
        border-collapse: collapse;
        background: var(--white);
        font-size: var(--font-sm);
    }

    /* Groups table (activity 1 new layout) */
    .pricing-table-wrap--groups {
        border-radius: 12px;
        border: 1px solid rgba(102, 51, 153, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        overflow-x: auto;
        overflow-y: visible;
    }

    .pricing-table--groups {
        width: 100%;
        min-width: 700px;
        border-collapse: collapse;
        background: var(--white);
        font-size: var(--font-sm);
        table-layout: fixed;
    }

    .pricing-table--groups th {
        padding: 0.85rem 0.75rem;
        text-align: center;
        font-weight: 700;
        font-size: var(--font-sm);
        vertical-align: top;
        color: var(--purple);
    }

    .pricing-table-col--purple {
        background: #f7f3fd;
    }

    .pricing-table-col--yellow {
        background: #fffaf5;
    }

    .pricing-table--groups th.pricing-table-col--purple,
    .pricing-table--groups th.pricing-table-col--yellow {
        background: #ddd0f0;
    }

    .td-big-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
    }

    .th-header {
        font-size: var(--font-base);
        font-weight: 800;
        color: var(--purple);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 0.25rem;
    }

    .th-sub {
        font-size: var(--font-xs);
        font-weight: 600;
        color: rgba(80, 40, 120, 0.65);
    }

    .pricing-table--groups td {
        padding: 0.6rem 0.75rem;
        text-align: center;
        vertical-align: middle;
    }

    .td-empty {
        /* inherits column color from pricing-table-col--* */
    }

    .td-discount-badge-host {
        position: relative;
        padding: 0 !important;
        overflow: visible;
        vertical-align: middle;
    }

    /* Placement of the discount badge/note (components are placement-agnostic). */
    .table-badge-slot {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 3;
        transform: translate(-50%, -50%) rotate(-15deg);
    }

    .discount-banner-slot {
        display: none;
    }

    .discount-note-slot--before-table {
        margin: 0 0 1rem;
    }

    .tr-big-canvas-header td {
        padding: 0.85rem 0.75rem 0.45rem;
        border-top: 1px dashed rgba(102, 51, 153, 0.25);
        background: #f3ecfb !important;
        color: var(--purple);
        font-size: var(--font-sm);
        font-weight: 700;
        text-align: center;
        letter-spacing: 0.01em;
    }

    .tr-big-canvas td {
        border-top: none !important;
    }

