---
import { createAstroTranslator, getCurrentLanguage, getLocalizedPath } from "../../utils/i18n";
import CTAButton from "../CTAButton.astro";
import activity1Image from "../../assets/photo/gallery/creacuadroabstracto.png";
import gallery4 from "../../assets/photo/gallery/gallery4.jpg";
import activity3Image from "../../assets/photo/gallery/crearopa.png";

const t = createAstroTranslator(Astro.currentLocale, "home");
const tCouples = createAstroTranslator(Astro.currentLocale, "couples");
const tMain = createAstroTranslator(Astro.currentLocale, "main");
const lang = getCurrentLanguage(Astro.currentLocale);

const activities = [
    {
        titleKey: "activity_1_title",
        descriptionKey: "activity_1_description",
        detailsKey: "activity_1_details_couples",
        includedKey: "activity_1_included",
        image: activity1Image,
        imageAlt: "Abstract painting with pouring and spinning techniques",
    },
    {
        titleKey: "activity_2_title",
        descriptionKey: "activity_2_description",
        detailsKey: "activity_2_details_couples",
        includedKey: "activity_2_included",
        image: gallery4,
        imageAlt: "Throwing paint and playful painting techniques",
    },
    {
        titleKey: "activity_3_title",
        descriptionKey: "activity_3_description",
        detailsKey: "activity_3_details_couples",
        includedKey: "activity_3_included",
        image: activity3Image,
        imageAlt: "Customizing clothes with abstract painting",
    },
];

const bookCouplesUrl = getLocalizedPath("/book/couples", lang);
---

<section id="what-we-offer" class="what-we-offer" data-menu-title={tMain("nav_offer")}>
    <div class="container">
        <h2 class="section-title">{tCouples("what_we_offer")}</h2>
        <p class="what-we-offer-intro">{tCouples("what_we_offer_intro")}</p>
        <div class="activities-list">
            {
                activities.map((activity, index) => (
                    <article class={`activity-card activity-card--${index % 2 === 0 ? "left" : "right"}`}>
                        <div class="activity-image-wrap">
                            <img
                                src={activity.image.src}
                                alt={activity.imageAlt}
                                class="activity-image"
                                loading="lazy"
                            />
                        </div>
                        <div class="activity-content">
                            <h3 class="activity-title">{t(activity.titleKey)}</h3>
                            <p class="activity-details" set:html={tCouples(activity.detailsKey)} />
                            <p class="activity-description">{t(activity.descriptionKey)}</p>
                            <p class="activity-included"><strong>{tCouples("included_title")}:</strong> {t(activity.includedKey)}</p>
                            <div class="activity-booking">
                                <CTAButton href={bookCouplesUrl} text={tCouples("cta_book")} size="sm" />
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .what-we-offer {
        padding: 3rem 0;
        background-color: var(--light-bg);
        scroll-margin-top: 60px;
    }

    .what-we-offer-intro {
        max-width: 600px;
        margin: 0 auto 3.5rem;
        text-align: center;
        font-size: var(--font-lg);
        line-height: 1.6;
        color: var(--dark-text);
    }

    .activities-list {
        display: flex;
        flex-direction: column;
        gap: 4rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .activity-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .activity-image-wrap {
        flex: 0 0 auto;
        width: 100%;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        position: relative;
        border-radius: 12px;
    }

    .activity-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .activity-content {
        padding: 1.5rem 1.25rem 2rem;
    }

    .activity-title {
        font-size: var(--font-xl);
        color: var(--purple);
        margin: 0 0 0.75rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .activity-description {
        font-size: var(--font-base);
        color: var(--dark-text);
        line-height: 1.6;
        margin: 0 0 1rem;
    }

    .activity-details {
        font-size: var(--font-sm);
        color: #000;
        margin: 0 0 0.75rem;
        line-height: 1.4;
    }

    .activity-included {
        font-size: var(--font-sm);
        color: var(--dark-text);
        line-height: 1.6;
        margin: 0 0 0.5rem;
    }

    .activity-booking {
        margin-top: 1.25rem;
        text-align: center;
    }

    .activity-booking :global(.cta-button) {
        width: auto;
        display: inline-block;
        min-width: 10rem;
    }

    .activity-included strong {
        color: var(--purple);
        font-weight: 600;
    }

    @media (min-width: 768px) {
        .activity-card {
            flex-direction: row;
            min-height: 280px;
        }

        .activity-card--left .activity-image-wrap {
            order: 0;
        }

        .activity-card--right .activity-image-wrap {
            order: 1;
        }

        .activity-image-wrap {
            flex: 0 0 45%;
            width: 45%;
            aspect-ratio: 3 / 4;
            min-height: 280px;
        }

        .activity-content {
            flex: 1;
            padding: 0 2.5rem 2rem;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        .activity-title {
            font-size: var(--font-2xl);
        }

        .activity-description {
            font-size: var(--font-base);
            margin-bottom: 1rem;
        }

        .activity-details {
            font-size: var(--font-base);
        }

        .activity-included {
            font-size: var(--font-base);
        }
    }
</style>
