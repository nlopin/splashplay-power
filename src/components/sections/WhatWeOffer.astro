---
import type { ImageMetadata } from "astro";
import { createAstroTranslator, getCurrentLanguage } from "../../utils/i18n";
import { getWhatWeOfferConfig, type WhatWeOfferVariant } from "../../config/whatWeOffer";
import type { ImageKey } from "../../config/whatWeOffer";
import CTAButton from "../CTAButton.astro";

import activity1Image from "../../assets/photo/gallery/creacuadroabstracto.png";
import gallery4 from "../../assets/photo/gallery/gallery4.jpg";
import activity3Image from "../../assets/photo/gallery/crearopa.png";
import gallery1 from "../../assets/photo/gallery/gallery1.jpg";
import oneBigSharedCanvas from "../../assets/img/one_big_shared_canvas.png";
import oneCanvasPerPerson from "../../assets/img/one_canvas_per_person.png";
import oneStandardSharedCanvas from "../../assets/img/one_standard_shared_canvas.png";
import oneStandardSharedCanvasPouring from "../../assets/img/one_standard_shared_canvas_pouring.jpg";
import oneStandardCanvasPerPersonPouring from "../../assets/img/one_standard_canvas_per_person_pouring.jpg";
import pouringVideo from "../../assets/video/techniques/pouring1K.mp4";
import spinningVideo from "../../assets/video/techniques/spinning1K.mp4";
import boxingVideo from "../../assets/video/techniques/boxing1K.mp4";
import balloonsVideo from "../../assets/video/techniques/balloons1K.mp4";
import padelVideo from "../../assets/video/techniques/padel.mp4";
import pistolasVideo from "../../assets/video/techniques/pistolas.mp4";
import drippingVideo from "../../assets/video/techniques/dripping.mp4";
import sorpresaVideo from "../../assets/video/techniques/sorpresa.mp4";

const IMAGES: Record<ImageKey, ImageMetadata> = {
  activity1: activity1Image,
  gallery4,
  activity3: activity3Image,
  gallery1,
};

const FORMAT_IMAGES = {
  largeCanvas: oneBigSharedCanvas,
  twoCanvases: oneCanvasPerPerson,
  twoCanvasesPouring: oneStandardCanvasPerPersonPouring,
  sharedCanvas: oneStandardSharedCanvas,
  sharedCanvasPouring: oneStandardSharedCanvasPouring,
};

const TECHNIQUE_VIDEOS: Record<string, string> = {
  pouring: pouringVideo,
  spinning: spinningVideo,
  dripping: drippingVideo,
  surprise: sorpresaVideo,
  boxing: boxingVideo,
  balloons: balloonsVideo,
  balls: padelVideo,
  guns: pistolasVideo,
};

interface Props {
  variant: WhatWeOfferVariant;
}

const { variant } = Astro.props;

const lang = getCurrentLanguage(Astro.currentLocale);
const config = getWhatWeOfferConfig(variant, lang);
const showActivityImages = variant !== "home" && variant !== "friends";
const showCommonIncluded = variant === "home" || variant === "friends";

const tMain = createAstroTranslator(Astro.currentLocale, "main");
const tSection = createAstroTranslator(Astro.currentLocale, config.sectionTitleNamespace);
const tIntro = createAstroTranslator(Astro.currentLocale, config.introNamespace);
const tIncluded = createAstroTranslator(Astro.currentLocale, config.includedTitleNamespace);
const tDetails = createAstroTranslator(Astro.currentLocale, config.detailsNamespace);
const tContent = createAstroTranslator(Astro.currentLocale, config.activityContentNamespace);
const tFormats = createAstroTranslator(
    Astro.currentLocale,
    config.formatContentNamespace ?? config.activityContentNamespace,
);
const tCorporate = createAstroTranslator(Astro.currentLocale, "corporate");

const activities = config.activities.map((a) => ({
  ...a,
  image: IMAGES[a.imageKey],
}));
---

<section id="what-we-offer" class="what-we-offer" data-menu-title={tMain("nav_offer")}>
    <div class="container">
        <h2 class="section-title">{tSection("what_we_offer")}</h2>
        <div class="what-we-offer-intro" set:html={tIntro("what_we_offer_intro")} />
        <div class="activities-list">
            {
                activities.map((activity, index) => (
                    <>
                        <article class:list={[
                            "activity-card",
                            `activity-card--${index % 2 === 0 ? "left" : "right"}`,
                            { "activity-card--no-image": !showActivityImages },
                        ]}>
                            {showActivityImages && (
                                <div class="activity-image-wrap">
                                    <img
                                        src={activity.image.src}
                                        alt={activity.imageAlt}
                                        class="activity-image"
                                        loading="lazy"
                                    />
                                </div>
                            )}
                            <div class="activity-content">
                                <h3 class="activity-title">
                                    {activity.corporateOnly
                                        ? tCorporate(activity.titleKey)
                                        : tContent(activity.titleKey)}
                                </h3>
                                <p
                                    class="activity-details"
                                    set:html={
                                        activity.corporateOnly
                                            ? tCorporate(activity.detailsKey)
                                            : tDetails(activity.detailsKey)
                                    }
                                />
                                <p class="activity-description">
                                    {activity.corporateOnly
                                        ? tCorporate(activity.descriptionKey)
                                        : tContent(activity.descriptionKey)}
                                </p>
                                {activity.techniqueIds && activity.techniqueIds.length > 0 && (
                                    <div class="activity-techniques">
                                        <h4 class="activity-subtitle">{tContent("techniques_title")}</h4>
                                        <div class="activity-techniques-grid">
                                            {activity.techniqueIds.map((techniqueId) => (
                                                <div class="activity-technique">
                                                    <div class="activity-technique-video-wrap">
                                                        <video
                                                            class="activity-technique-video"
                                                            muted
                                                            loop
                                                            playsinline
                                                            autoplay
                                                        >
                                                            <source src={TECHNIQUE_VIDEOS[techniqueId]} type="video/mp4" />
                                                        </video>
                                                    </div>
                                                    <strong>{tMain(`techniques.${techniqueId}.title`)}</strong>
                                                    <span>{tMain(`techniques.${techniqueId}.description`)}</span>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}
                                {activity.formatCards && activity.formatCards.length > 0 && (
                                    <div class="activity-formats">
                                        <h4 class="activity-subtitle">{tContent("formats_title")}</h4>
                                        <div class:list={[
                                            "activity-format-cards",
                                            `activity-format-cards--${activity.formatCards.length}`,
                                        ]}>
                                            {activity.formatCards.map((format) => (
                                                <div class="activity-format-card">
                                                    <div class="activity-format-image-wrap">
                                                        <img
                                                            src={FORMAT_IMAGES[format.imageKey].src}
                                                            alt={tContent(format.titleKey)}
                                                            class="activity-format-image"
                                                            loading="lazy"
                                                        />
                                                    </div>
                                                    <div class="activity-format-body">
                                                        <h5>{tContent(format.titleKey)}</h5>
                                                        <p>{tFormats(format.descriptionKey)}</p>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                        {activity.formatNoteKey && (
                                            <p class="activity-format-note" set:html={tContent(activity.formatNoteKey)} />
                                        )}
                                    </div>
                                )}
                                {!showCommonIncluded && (
                                    <>
                                        <p class="activity-included">
                                            <strong>{tIncluded("included_title")}:</strong>{" "}
                                            {activity.corporateOnly
                                                ? tCorporate(activity.includedKey)
                                                : tContent(activity.includedKey)}
                                        </p>
                                        {activity.includedKey === "activity_1_included" && (
                                            <>
                                                <p class="activity-included">
                                                    <strong>{tContent("common_takeaway_title")}:</strong>{" "}
                                                    {tContent("common_takeaway_text")}
                                                </p>
                                                <p class="activity-included-note">{tContent("activity_1_drying_note")}</p>
                                            </>
                                        )}
                                    </>
                                )}
                                {config.bookingMode === "table" && activity.bookingRows && (
                                    <div class="activity-booking">
                                        <h4 class="activity-booking-title">{tContent("booking_selector_title")}</h4>
                                        <div class="activity-booking-options">
                                            {activity.bookingRows.map((row) => (
                                                <div class="activity-booking-option">
                                                    <a href={row.pageHref} class="activity-booking-audience-link">
                                                        {tContent(row.audienceKey)}
                                                    </a>
                                                    <a href={row.href} class="activity-booking-btn">
                                                        {tContent(row.ctaKey)}
                                                    </a>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}
                                {config.bookingMode === "single-cta" && activity.bookUrl && config.ctaKey && (
                                    <div class="activity-booking">
                                        <CTAButton href={activity.bookUrl} text={tSection(config.ctaKey)} size="sm" />
                                    </div>
                                )}
                                {config.bookingMode === "contact" && config.ctaKey && (
                                    <div class="activity-actions">
                                        <CTAButton href="#contact" text={tCorporate(config.ctaKey)} size="sm" />
                                    </div>
                                )}
                            </div>
                        </article>
                        {config.showHowItWorks && index === 0 && (
                            <div class="howitworks-wrap">
                                <details class="howitworks-details howitworks-details--offer">
                                    <summary class="howitworks-summary">{tCorporate("howitworks_toggle")}</summary>
                                    <div class="howitworks-content" set:html={tCorporate("howitworks_content")} />
                                </details>
                            </div>
                        )}
                    </>
                ))
            }
            {showCommonIncluded && (
                <aside class="common-included" aria-label={tIncluded("included_title")}>
                    <p class="common-included-text">
                        <strong>{tIncluded("included_title")}:</strong>{" "}
                        {tContent("activity_1_included")}
                    </p>
                    <p class="common-included-text">
                        <strong>{tContent("common_takeaway_title")}:</strong>{" "}
                        {tContent("common_takeaway_text")}
                    </p>
                    <p class="common-included-note">{tContent("activity_1_drying_note")}</p>
                </aside>
            )}
        </div>
    </div>
</section>

<style>
    .what-we-offer {
        padding: 3rem 0;
        background-color: var(--light-bg);
        scroll-margin-top: 60px;
    }

    .what-we-offer-intro {
        max-width: 860px;
        margin: 0 auto 3.5rem;
        padding-inline: 1rem;
        text-align: center;
        font-size: var(--font-base);
        line-height: 1.6;
        color: var(--dark-text);
    }

    .what-we-offer-intro :global(p) {
        margin: 0;
    }

    .what-we-offer-intro :global(p + p) {
        margin-top: 1rem;
    }

    .activities-list {
        display: flex;
        flex-direction: column;
        gap: 4rem;
        max-width: 1220px;
        margin: 0 auto;
    }

    .activity-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .activity-card--no-image {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
    }

    .activity-image-wrap {
        flex: 0 0 auto;
        width: 100%;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        position: relative;
        border-radius: 12px;
    }

    .activity-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .activity-content {
        padding: 1.5rem 1.25rem 2rem;
    }

    .activity-title {
        font-size: var(--font-xl);
        color: var(--purple);
        margin: 0 0 0.75rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .activity-description {
        font-size: var(--font-base);
        color: var(--dark-text);
        line-height: 1.6;
        margin: 0 0 1rem;
    }

    .activity-details {
        font-size: var(--font-sm);
        color: #000;
        margin: 0 0 0.75rem;
        line-height: 1.4;
    }

    .activity-included {
        font-size: var(--font-sm);
        color: var(--dark-text);
        line-height: 1.6;
        margin: 0 0 0.5rem;
    }

    .activity-subtitle {
        margin: 0 0 0.75rem;
        color: var(--purple);
        font-size: var(--font-base);
        font-weight: 700;
    }

    .activity-techniques,
    .activity-formats {
        margin: 0 0 1rem;
    }

    .activity-techniques-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .activity-technique {
        overflow: hidden;
        border: 1px solid rgba(102, 51, 153, 0.12);
        border-radius: 12px;
        background: var(--white);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
    }

    .activity-technique-video-wrap {
        position: relative;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        background: rgba(102, 51, 153, 0.08);
    }

    .activity-technique-video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .activity-technique strong {
        display: block;
        margin: 0.65rem 0.75rem 0.25rem;
        color: var(--purple);
        font-size: var(--font-sm);
    }

    .activity-technique span {
        display: block;
        margin: 0 0.75rem 0.75rem;
        color: var(--dark-text);
        font-size: var(--font-sm);
        line-height: 1.45;
    }

    .activity-format-cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.9rem;
        justify-content: center;
    }

    .activity-format-card {
        overflow: hidden;
        border-radius: 12px;
        background: var(--white);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .activity-format-image-wrap {
        overflow: hidden;
        background: var(--white);
    }

    .activity-format-image {
        width: 100%;
        height: auto;
        display: block;
    }

    .activity-format-body {
        padding: 1rem;
    }

    .activity-format-body h5 {
        margin: 0 0 0.5rem;
        color: var(--purple);
        font-size: var(--font-base);
        line-height: 1.3;
    }

    .activity-format-body p {
        margin: 0;
        color: var(--dark-text);
        font-size: var(--font-sm);
        line-height: 1.55;
    }

    .activity-format-note {
        margin: 1rem 0 0;
        padding: 0.9rem 1rem;
        border-left: 4px solid var(--orange);
        border-radius: 10px;
        background: rgba(102, 51, 153, 0.06);
        color: var(--dark-text);
        font-size: var(--font-sm);
        line-height: 1.55;
    }

    .activity-format-note :global(strong) {
        color: var(--purple);
    }

    .activity-booking {
        margin-top: 1.25rem;
        padding: 1.1rem;
        border: 1px solid rgba(102, 51, 153, 0.12);
        border-radius: 14px;
        background: var(--white);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .activity-booking:has(.cta-button) {
        padding-top: 0;
        border-top: none;
        text-align: center;
    }

    .activity-booking :global(.cta-button) {
        width: auto;
        display: inline-block;
        min-width: 10rem;
    }

    .activity-booking-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--font-sm);
    }

    .activity-booking-title {
        margin: 0 0 0.75rem;
        color: var(--purple);
        font-size: var(--font-base);
        font-weight: 700;
        line-height: 1.3;
    }

    .activity-booking-options {
        display: grid;
        gap: 0.55rem;
    }

    .activity-booking-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.65rem 0.75rem;
        border-radius: 10px;
        background: rgba(102, 51, 153, 0.045);
        transition: background-color 0.2s ease;
    }

    .activity-booking-option:hover {
        background: rgba(102, 51, 153, 0.08);
    }

    .activity-booking-table tr:not(:last-child) {
        border-bottom: 1px solid rgba(102, 51, 153, 0.1);
    }

    .activity-booking-audience {
        padding: 0.5rem 0.75rem 0.5rem 0;
        font-size: var(--font-base);
        font-weight: 700;
        vertical-align: middle;
    }

    .activity-booking-audience-link {
        color: var(--purple);
        text-decoration: none;
        font-weight: 700;
    }

    .activity-booking-audience-link:hover {
        color: var(--orange);
    }

    .activity-booking-cell {
        padding: 0.5rem 0;
        text-align: right;
        vertical-align: middle;
    }

    .activity-booking-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 7.5rem;
        padding: 0.55rem 1rem;
        font-size: var(--font-sm);
        font-weight: 700;
        color: var(--white);
        background-color: var(--orange);
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(255, 107, 53, 0.35);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        transition: all 0.2s ease;
        white-space: nowrap;
        text-align: center;
        box-sizing: border-box;
    }

    .activity-booking-btn:hover {
        background-color: var(--purple);
        box-shadow: 0 4px 10px rgba(102, 51, 153, 0.4);
        transform: translateY(-2px);
    }

    .activity-included strong {
        color: var(--purple);
        font-weight: 600;
    }

    .common-included {
        max-width: 820px;
        margin: 0 auto;
        padding: 0 1.25rem;
        text-align: center;
    }

    .common-included-text {
        margin: 0;
        color: var(--dark-text);
        font-size: var(--font-base);
        line-height: 1.6;
    }

    .common-included-text + .common-included-text {
        margin-top: 1rem;
    }

    .common-included-text strong {
        color: var(--purple);
        font-weight: 600;
    }

    .common-included-note,
    .activity-included-note {
        margin: 0.75rem 0 0;
        color: var(--dark-text);
        font-size: var(--font-base);
        line-height: 1.6;
    }

    .activity-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .activity-actions :global(.cta-button) {
        max-width: 200px;
    }

    .howitworks-wrap {
        width: 100%;
        display: flex;
        justify-content: center;
        margin: 0 0 2rem;
    }

    .howitworks-details--offer {
        margin: 0;
        text-align: center;
    }

    .howitworks-details--offer .howitworks-summary {
        font-size: var(--font-sm);
        padding: 0.5rem 0;
    }

    .howitworks-details--offer .howitworks-content {
        font-size: var(--font-sm);
        padding: 0.5rem 0;
        text-align: left;
        max-width: 700px;
        margin: 0 auto;
    }

    .howitworks-details--offer .howitworks-content :global(p) {
        margin: 0 0 0.5rem;
    }

    .howitworks-details--offer .howitworks-content :global(strong) {
        color: var(--purple);
    }

    .howitworks-summary {
        font-weight: 600;
        color: var(--purple);
        cursor: pointer;
        list-style: none;
        text-transform: uppercase;
    }

    .howitworks-summary::-webkit-details-marker {
        display: none;
    }

    .howitworks-summary::after {
        content: " ▼";
        font-size: 1.2em;
        display: inline-block;
        margin-left: 0.25rem;
        transition: transform 0.2s;
    }

    .howitworks-details[open] .howitworks-summary::after {
        transform: rotate(-180deg);
    }

    @media (min-width: 768px) {
        .activity-card {
            flex-direction: row;
            min-height: 280px;
        }

        .activity-card--left .activity-image-wrap {
            order: 0;
        }

        .activity-card--right .activity-image-wrap {
            order: 1;
        }

        .activity-image-wrap {
            flex: 0 0 45%;
            width: 45%;
            aspect-ratio: 3 / 4;
            min-height: 280px;
        }

        .activity-content {
            flex: 1;
            padding: 0 2.5rem 2rem;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        .activity-card--no-image .activity-content {
            padding: 0 1rem 2rem;
            text-align: center;
        }

        .activity-card--no-image .activity-description,
        .activity-card--no-image .activity-details,
        .activity-card--no-image .activity-included {
            max-width: 780px;
            margin-left: auto;
            margin-right: auto;
        }

        .activity-card--no-image .activity-booking {
            max-width: 780px;
            width: 100%;
            margin-left: auto;
            margin-right: auto;
            text-align: initial;
        }

        .activity-title {
            font-size: var(--font-2xl);
        }

        .activity-description {
            font-size: var(--font-base);
            margin-bottom: 1rem;
        }

        .activity-details {
            font-size: var(--font-base);
        }

        .activity-included {
            font-size: var(--font-base);
        }

        .activity-techniques-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .activity-format-cards {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }

        .activity-format-cards--2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            width: min(780px, 100%);
            justify-self: center;
            place-self: center;
            margin-inline: auto;
        }

        .activity-actions {
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }
    }
</style>
