---
import { createAstroTranslator } from "../../utils/i18n";
import CTAButton from "../CTAButton.astro";

const t = createAstroTranslator(Astro.currentLocale, "main");

const steps = [
    { titleKey: "step1_title", descriptionKey: "step1_description" },
    { titleKey: "step2_title", descriptionKey: "step2_description" },
    { titleKey: "step3_title", descriptionKey: "step3_description" },
    { titleKey: "step3b_title", descriptionKey: "step3b_description" },
    { titleKey: "step4_title", descriptionKey: "step4_description" },
    { titleKey: "step5_title", descriptionKey: "step5_description" },
    { titleKey: "step6_title", descriptionKey: "step6_description" },
];
---

<section id="experience" class="experience">
    <div class="container">
        <h2 class="section-title">{t("experience_steps")}</h2>

        <ol class="steps">
            {
                steps.map((step) => (
                    <li class="step-item">
                        <div class="step-content">
                            <h3 class="step-title">{t(step.titleKey)}</h3>
                            <p
                                class="step-description"
                                set:html={t(step.descriptionKey)}
                            />
                        </div>
                    </li>
                ))
            }
        </ol>

        <div class="experience-cta">
            <p class="experience-prompt">{t("ready_create")}</p>
            <div class="cta-container">
                <CTAButton text={t("cta_book")} href="#pricing" />
            </div>
        </div>
    </div>
</section>

<style>
    :global(.experience) {
        padding: 3rem 0;
        background-color: var(--white);
        scroll-margin-top: 60px;
    }

    :global(.steps) {
        list-style: none;
        counter-reset: step-counter;
        padding: 0;
        max-width: 700px;
        margin: 0 auto 2rem;
    }

    :global(.step-item) {
        counter-increment: step-counter;
        position: relative;
        padding-left: 3.5rem;
        margin-bottom: 2rem;
    }

    :global(.step-item)::before {
        content: counter(step-counter);
        position: absolute;
        left: 0;
        top: 0;
        width: 2.5rem;
        height: 2.5rem;
        background-color: var(--orange);
        color: var(--white);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: var(--font-lg);
    }

    :global(.step-item.no-counter)::before {
        content: none;
        display: none;
    }

    :global(.step-title) {
        font-size: var(--font-lg);
        color: var(--purple);
        margin-bottom: 0.5rem;
    }

    :global(.step-description) {
        font-size: var(--font-base);
        color: var(--dark-text);
        line-height: 1.5;
        margin: 0;
    }

    :global(.experience-cta) {
        text-align: center;
        margin-top: 3rem;
    }

    :global(.cta-container) {
        max-width: 300px;
        margin: 0 auto;
    }

    :global(.experience-prompt) {
        font-size: var(--font-lg);
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 1rem;
    }

    @media (min-width: 769px) {
        :global(.steps) {
            max-width: 800px;
        }

        :global(.step-item) {
            padding-left: 5rem;
            margin-bottom: 3rem;
        }

        :global(.step-item)::before {
            width: 3.5rem;
            height: 3.5rem;
            font-size: var(--font-xl);
        }

        :global(.step-title) {
            font-size: var(--font-xl);
        }

        :global(.step-description) {
            font-size: var(--font-md);
        }

        :global(.experience-prompt) {
            font-size: var(--font-xl);
        }
    }

    @media (max-width: 768px) {
        :global(.step-item) {
            padding-left: 3.5rem;
        }

        :global(.step-item)::before {
            width: 2.5rem;
            height: 2.5rem;
            font-size: var(--font-lg);
        }

        :global(.step-title) {
            font-size: var(--font-lg);
        }

        :global(.step-description) {
            font-size: var(--font-base);
        }

        :global(.experience-prompt) {
            font-size: var(--font-lg);
        }
    }
</style>
