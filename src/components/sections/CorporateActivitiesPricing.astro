---
import {
    createAstroTranslator,
    getCurrentLanguage,
} from "../../utils/i18n";
import smallCanvas from "../../assets/img/30x40_compartido.jpg";
import largeCanvas from "../../assets/img/60x80_compartido.jpg";
import twoCanvases from "../../assets/img/30x40_2individuales.jpg";
import clothing1 from "../../assets/photo/clothing/clothing1-074c0620-2ca8-40fd-b3b0-c18bdfb1199c.png";
import clothing2 from "../../assets/photo/clothing/clothing2-71fec5c8-abb0-43c7-b790-5d926bd3b104.png";
import clothing3 from "../../assets/photo/clothing/clothing3-f0f01b38-f4ca-4930-9a3b-163e191923ce.png";
import clothing4 from "../../assets/photo/clothing/clothing4-848c4160-7c5c-43f9-83ce-2ce5febb0bb6.png";

const t = createAstroTranslator(Astro.currentLocale, "friends");
const tCorporate = createAstroTranslator(Astro.currentLocale, "corporate");
const tMain = createAstroTranslator(Astro.currentLocale, "main");
const tHome = createAstroTranslator(Astro.currentLocale, "home");

const clothingPhotos = [clothing1, clothing2, clothing3, clothing4];

// Only 4, 5, 6 people (removed 2 and 3 people)
const activity1Groups = [
    { headerKey: "pt_group_4_header", subheaderKey: "pt_group_4_sub" },
    { headerKey: "pt_group_5_header", subheaderKey: "pt_group_5_sub" },
    { headerKey: "pt_group_6_header", subheaderKey: "pt_group_6_sub" },
];

type OptCell = { labelKey: string; priceKey: string } | null;
const activity1Rows: { cells: OptCell[] }[] = [
    { cells: [null, null, null] },
    { cells: [
        { labelKey: "pt_4_opt2", priceKey: "pt_4_opt2_pp" },
        null, null,
    ]},
    { cells: [
        { labelKey: "pt_4_opt3", priceKey: "pt_4_opt3_pp" },
        { labelKey: "pt_5_opt3", priceKey: "pt_5_opt3_pp" },
        { labelKey: "pt_6_opt3", priceKey: "pt_6_opt3_pp" },
    ]},
    { cells: [
        { labelKey: "pt_4_opt4", priceKey: "pt_4_opt4_pp" },
        { labelKey: "pt_5_opt4", priceKey: "pt_5_opt4_pp" },
        { labelKey: "pt_6_opt4", priceKey: "pt_6_opt4_pp" },
    ]},
    { cells: [
        null,
        { labelKey: "pt_5_opt5", priceKey: "pt_5_opt5_pp" },
        { labelKey: "pt_6_opt5", priceKey: "pt_6_opt5_pp" },
    ]},
    { cells: [
        null, null,
        { labelKey: "pt_6_opt6", priceKey: "pt_6_opt6_pp" },
    ]},
];

const activity1BigRow: OptCell[] = [
    { labelKey: "pt_4_big", priceKey: "pt_4_big_pp" },
    { labelKey: "pt_5_big", priceKey: "pt_5_big_pp" },
    { labelKey: "pt_6_big", priceKey: "pt_6_big_pp" },
];

const activity1GroupsWithOptions = activity1Groups.map((group, gi) => ({
    ...group,
    options: [
        ...activity1Rows.map(row => row.cells[gi]).filter(Boolean) as { labelKey: string; priceKey: string }[],
        activity1BigRow[gi] as { labelKey: string; priceKey: string },
    ],
}));

function headerWithHighlightedNum(text: string) {
    const match = text.match(/^(\d+)(.*)$/);
    if (match) {
        return { num: match[1], rest: match[2] };
    }
    return null;
}

function renderHeaderHtml(raw: string) {
    const withSize = raw.replace(/(\d+[x×]\d+)/g, '<span class="header-size">$1</span>');
    const parsed = headerWithHighlightedNum(withSize);
    return parsed ? `<span class="header-num">${parsed.num}</span>${parsed.rest}` : withSize;
}

function parseOptLabel(text: string): { canvasLabel: string; price: string } | null {
    const match = text.match(/^(.+?)\s*[—–-]\s*(€\S+)$/);
    if (match) {
        return { canvasLabel: match[1].trim(), price: match[2].trim() };
    }
    return null;
}
---

<section id="pricing" class="prices prices--corporate-activities" data-menu-title={tMain("nav_pricing")}>
    <div class="container">
        <h2 class="section-title">{t("pricing_title")}</h2>

        <!-- Team Building Special -->
        <div id="pricing-teambuilding" class="pricing-activity pricing-activity--simple">
            <h3 class="pricing-activity-title">
                {tCorporate("activity_teambuilding_title")}
                <span class="pricing-activity-meta">{tCorporate("activity_teambuilding_meta")}</span>
            </h3>
            <p class="pricing-activity-description">{tCorporate("activity_teambuilding_description")}</p>
            <p class="pricing-simple-price">{tCorporate("activity_teambuilding_price")}</p>
        </div>

        <!-- Activity 1: Create your abstract masterpiece -->
        <div id="pricing-activity1" class="pricing-activity pricing-activity--wide">
            <h3 class="pricing-activity-title">
                {tHome("activity_1_title")}
                <span class="pricing-activity-meta">{tCorporate("activity_1_meta")}</span>
            </h3>
            <p class="pricing-activity-description" set:html={t("pricing_activity1_description")} />
            <!-- Mobile: one card per group size -->
            <div class="pricing-cards-mobile">
                {activity1GroupsWithOptions.map((group) => (
                    <div class="pricing-card-mobile pricing-card-mobile--group">
                        <div class="pricing-card-mobile-header">{t(group.headerKey)}</div>
                        <div class="pricing-card-mobile-subheader">{t(group.subheaderKey)}</div>
                        <ul class="pricing-card-mobile-options">
                            {group.options.map((opt) => {
                                const parsed = parseOptLabel(t(opt.labelKey));
                                return (
                                    <li>
                                        <span class="opt-row-main">
                                            <span class="opt-canvas-label">{parsed ? parsed.canvasLabel : t(opt.labelKey)}</span>
                                            {parsed && <span class="opt-canvas-price">{parsed.price}</span>}
                                        </span>
                                        <span class="opt-price">{t(opt.priceKey)}</span>
                                    </li>
                                );
                            })}
                        </ul>
                    </div>
                ))}
            </div>
            <!-- Desktop table: columns = group sizes, rows = canvas options -->
            <div class="pricing-table-wrap pricing-table-wrap--groups">
                <table class="pricing-table pricing-table--groups">
                    <thead>
                        <tr>
                            {activity1Groups.map((group) => (
                                <th scope="col" style="background: #ddd0f0; color: var(--purple);">
                                    <div class="th-header" style="color: var(--purple);">{t(group.headerKey)}</div>
                                    <div class="th-sub" style="color: rgba(80,40,120,0.65);">{t(group.subheaderKey)}</div>
                                </th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {activity1Rows.map((row) => (
                            <tr>
                                {row.cells.map((cell) => {
                                    if (!cell) return <td class="td-empty" />;
                                    const parsed = parseOptLabel(t(cell.labelKey));
                                    return (
                                        <td>
                                            <span class="opt-row-main">
                                                <span class="opt-canvas-label">{parsed ? parsed.canvasLabel : t(cell.labelKey)}</span>
                                                {parsed && <span class="opt-canvas-price">{parsed.price}</span>}
                                            </span>
                                            <span class="opt-price">{t(cell.priceKey)}</span>
                                        </td>
                                    );
                                })}
                            </tr>
                        ))}
                        <tr class="tr-big-canvas">
                            {activity1BigRow.map((cell) => {
                                if (!cell) return <td class="td-empty" />;
                                const parsed = parseOptLabel(t(cell.labelKey));
                                return (
                                    <td>
                                        <span class="opt-row-main">
                                            <span class="opt-canvas-label">{parsed ? parsed.canvasLabel : t(cell.labelKey)}</span>
                                            {parsed && <span class="opt-canvas-price">{parsed.price}</span>}
                                        </span>
                                        <span class="opt-price">{t(cell.priceKey)}</span>
                                    </td>
                                );
                            })}
                        </tr>
                    </tbody>
                </table>
            </div>
            <h4 class="canvas-reference-title">{t("canvas_size_reference")}</h4>
            <div class="canvas-examples">
                <div class="canvas-example">
                    <span class="canvas-example-img-wrap">
                        <img src={smallCanvas.src} alt="30×40 cm" class="canvas-example-image" />
                    </span>
                    <span class="canvas-example-caption">Standard 30×40 cm</span>
                </div>
                <div class="canvas-example">
                    <span class="canvas-example-img-wrap">
                        <img src={largeCanvas.src} alt="60×80 cm" class="canvas-example-image" />
                    </span>
                    <span class="canvas-example-caption">Big 60×80 cm</span>
                </div>
                <div class="canvas-example">
                    <span class="canvas-example-img-wrap">
                        <img src={twoCanvases.src} alt="2× 30×40 cm" class="canvas-example-image" />
                    </span>
                    <span class="canvas-example-caption">2 standard 30×40 cm</span>
                </div>
            </div>
        </div>

        <!-- Activity 2: Throw paint & have fun! -->
        <div id="pricing-activity2" class="pricing-activity pricing-activity--simple">
            <h3 class="pricing-activity-title">
                {tHome("activity_2_title")}
                <span class="pricing-activity-meta">{tCorporate("activity_2_meta")}</span>
            </h3>
            <p class="pricing-activity-description">{t("activity_2_description")}</p>
            <p class="pricing-simple-price">{tCorporate("activity_simple_price")}</p>
        </div>

        <!-- Activity 3: Customize your clothes -->
        <div id="pricing-activity3" class="pricing-activity pricing-activity--simple">
            <h3 class="pricing-activity-title">
                {tHome("activity_3_title")}
                <span class="pricing-activity-meta">{tCorporate("activity_3_meta")}</span>
            </h3>
            <p class="pricing-activity-description">{t("activity_3_description")}</p>
            <div class="clothing-photos">
                {clothingPhotos.map((img) => (
                    <span class="clothing-photo-wrap">
                        <img src={img.src} alt="Customized clothing" class="clothing-photo" />
                    </span>
                ))}
            </div>
            <p class="pricing-simple-price">{tCorporate("activity_simple_price")}</p>
        </div>
    </div>
</section>

<style>
    .prices--corporate-activities {
        padding: 3rem 0;
        background-color: var(--white);
        scroll-margin-top: 60px;
    }

    .prices--corporate-activities .section-title {
        text-align: center;
    }

    .pricing-activity {
        max-width: 900px;
        margin: 0 auto 3rem;
        text-align: center;
    }

    .pricing-activity:last-child {
        margin-bottom: 0;
    }

    .pricing-activity--wide {
        max-width: 1100px;
    }

    .pricing-activity-title {
        font-size: var(--font-xl);
        color: var(--purple);
        font-weight: 700;
        margin: 0 0 1rem;
        line-height: 1.3;
    }

    .pricing-activity-meta {
        display: inline;
        font-size: var(--font-base);
        font-weight: 700;
        color: var(--dark-text);
        margin-left: 0.5rem;
    }

    .pricing-activity-description {
        font-size: var(--font-base);
        color: var(--dark-text);
        line-height: 1.6;
        margin: 0 0 1.5rem;
    }

    .pricing-simple-price {
        font-size: var(--font-2xl);
        font-weight: 700;
        color: var(--orange);
        margin: 0;
    }

    .howitworks-details {
        margin-top: 1.5rem;
        text-align: center;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    .howitworks-summary {
        font-size: var(--font-base);
        font-weight: 600;
        color: var(--purple);
        cursor: pointer;
        list-style: none;
        padding: 0.75rem 0;
        user-select: none;
        text-transform: uppercase;
    }

    .howitworks-summary::-webkit-details-marker {
        display: none;
    }

    .howitworks-summary::after {
        content: " ▼";
        font-size: 1.2em;
        display: inline-block;
        margin-left: 0.25rem;
        transition: transform 0.2s;
    }

    .howitworks-details[open] .howitworks-summary::after {
        transform: rotate(-180deg);
    }

    .howitworks-content {
        font-size: var(--font-sm);
        color: var(--dark-text);
        line-height: 1.6;
        padding-bottom: 0.5rem;
    }

    .howitworks-content :global(p) {
        margin: 0 0 0.75rem;
    }

    .howitworks-content :global(p:last-child) {
        margin-bottom: 0;
    }

    .howitworks-content :global(strong) {
        color: var(--purple);
    }

    .clothing-photos {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .clothing-photo-wrap {
        display: block;
        border-radius: 12px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .clothing-photo {
        display: block;
        width: 100%;
        max-width: 140px;
        height: auto;
        object-fit: contain;
        vertical-align: top;
    }

    @media (max-width: 600px) {
        .clothing-photo {
            max-width: 100px;
        }
    }

    .canvas-reference-title {
        font-size: var(--font-sm);
        font-weight: 600;
        color: var(--purple);
        margin: 2rem 0 1rem;
        text-align: center;
    }

    .canvas-examples {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        max-width: 560px;
        margin: 0 auto 1.5rem;
    }

    .canvas-example {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .canvas-example-img-wrap {
        display: block;
        border-radius: 12px;
        overflow: hidden;
    }

    .canvas-example-image {
        display: block;
        width: 100%;
        height: auto;
        vertical-align: top;
    }

    .canvas-example-caption {
        font-size: var(--font-xs);
        color: var(--purple);
        font-weight: 600;
        margin-top: 0.5rem;
    }

    @media (max-width: 600px) {
        .canvas-examples {
            grid-template-columns: 1fr;
            max-width: 280px;
        }
    }

    .pricing-cards-mobile {
        display: none;
    }

    .pricing-table-wrap {
        overflow-x: auto;
        border-radius: 12px;
        border: 1px solid rgba(102, 51, 153, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }

    .pricing-table {
        width: 100%;
        min-width: 600px;
        border-collapse: collapse;
        background: var(--white);
        font-size: var(--font-sm);
    }

    .pricing-table-wrap--groups {
        border-radius: 12px;
        border: 1px solid rgba(102, 51, 153, 0.12);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        overflow-x: auto;
    }

    .pricing-table--groups {
        width: 100%;
        min-width: 700px;
        border-collapse: collapse;
        background: var(--white);
        font-size: var(--font-sm);
        table-layout: fixed;
    }

    .pricing-table--groups th {
        padding: 0.85rem 0.75rem;
        text-align: center;
        font-weight: 700;
        font-size: var(--font-sm);
        vertical-align: top;
        background: var(--purple);
        color: var(--white);
    }

    .pricing-table--groups td:nth-child(odd) {
        background: #f7f3fd;
    }

    .pricing-table--groups td:nth-child(even) {
        background: #fffaf5;
    }

    .th-header {
        font-size: var(--font-base);
        font-weight: 800;
        color: var(--purple);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 0.25rem;
    }

    .th-sub {
        font-size: var(--font-xs);
        font-weight: 600;
        color: rgba(255, 255, 255, 0.75);
    }

    .pricing-table--groups td {
        padding: 0.6rem 0.75rem;
        text-align: center;
        vertical-align: middle;
    }

    .tr-big-canvas td {
        border-top: 1px dashed rgba(102, 51, 153, 0.25) !important;
    }

    .opt-row-main {
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .opt-canvas-label {
        font-size: var(--font-base);
        font-weight: 700;
        color: var(--purple);
    }

    .opt-canvas-price {
        font-size: var(--font-base);
        font-weight: 800;
        color: var(--orange);
    }

    .opt-price {
        font-size: var(--font-sm);
        font-weight: 400;
        color: var(--dark-text);
    }

    .pricing-card-mobile--group .pricing-card-mobile-subheader {
        font-size: var(--font-xs);
        color: var(--dark-text);
        opacity: 0.7;
        margin-bottom: 0.75rem;
    }

    .pricing-card-mobile-options {
        list-style: none;
        margin: 0 0 1rem;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        text-align: left;
    }

    .pricing-card-mobile-options li {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.15rem;
        padding: 0.4rem 0;
        border-bottom: 1px solid rgba(102, 51, 153, 0.07);
        font-size: var(--font-sm);
    }

    .pricing-card-mobile-options li:last-child {
        border-bottom: none;
    }

    .pricing-card-mobile-options .opt-canvas-label {
        font-weight: 700;
        color: var(--purple);
    }

    .pricing-card-mobile-options .opt-canvas-price {
        font-weight: 800;
        color: var(--orange);
    }

    .pricing-card-mobile-options .opt-price {
        font-weight: 400;
        color: var(--dark-text);
        white-space: nowrap;
        margin-left: 0.25rem;
    }

    .pricing-table--simple {
        table-layout: fixed;
        min-width: 400px;
    }

    .pricing-table--simple th,
    .pricing-table--simple td {
        width: 33.333%;
    }

    .pricing-table:not(.pricing-table--groups) th {
        padding: 1rem 0.75rem;
        text-align: center;
        color: var(--purple);
    }

    .pricing-table:not(.pricing-table--groups) th:nth-child(odd) {
        background: #66339908;
    }

    .pricing-table:not(.pricing-table--groups) th:nth-child(even) {
        background: var(--white);
    }

    .pricing-table:not(.pricing-table--groups) td:nth-child(odd) {
        background: #66339908;
    }

    .pricing-table:not(.pricing-table--groups) td:nth-child(even) {
        background: var(--white);
    }

    .pricing-table th :global(.header-num) {
        color: var(--orange);
        font-weight: 900;
        font-size: 1.25em;
    }

    .pricing-table th :global(.header-size) {
        font-weight: 900;
    }

    .pricing-table td {
        padding: 0.75rem;
        text-align: center;
        border-bottom: 1px solid rgba(102, 51, 153, 0.08);
    }

    .pricing-table tbody tr:last-child td {
        border-bottom: none;
    }

    .pricing-table .price-total {
        font-size: var(--font-base);
        font-weight: 700;
        color: var(--purple);
    }

    .pricing-card-mobile {
        background: var(--white);
        border: 1px solid rgba(102, 51, 153, 0.12);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .pricing-card-mobile:last-child {
        margin-bottom: 0;
    }

    .pricing-card-mobile-header {
        font-size: var(--font-base);
        font-weight: 700;
        color: var(--purple);
        margin-bottom: 0.75rem;
    }

    .pricing-card-mobile-header :global(.header-num) {
        color: var(--orange);
    }

    .pricing-card-mobile-price {
        font-size: var(--font-2xl);
        font-weight: 700;
        color: var(--orange);
        margin-bottom: 0.5rem;
    }

    @media (max-width: 767px) {
        .pricing-cards-mobile {
            display: block;
            margin-bottom: 1.5rem;
        }

        .pricing-table-wrap,
        .pricing-table-wrap--groups {
            display: none;
        }
    }

    @media (min-width: 768px) {
        .pricing-table-wrap,
        .pricing-table-wrap--groups {
            display: block;
        }
    }
</style>
