---
import { createAstroTranslator } from "../utils/i18n";
import PageLayout from "../layouts/PageLayout.astro";

import FamilyHero from "./sections/FamilyHero.astro";
import FamilyWhatWeOffer from "./sections/FamilyWhatWeOffer.astro";
import Techniques from "./sections/Techniques.astro";
import Testimonials from "./sections/Testimonials.astro";
import FamilyPricing from "./sections/FamilyPricing.astro";
import WhatsIncluded from "./sections/WhatsIncluded.astro";
import GiftCard from "./sections/GiftCards.astro";
import ExperienceSteps from "./sections/ExperienceSteps.astro";
import Gallery from "./sections/Gallery.astro";
import OurTeam from "./sections/OurTeam.astro";
import Contact from "./sections/Contact.astro";

const t = createAstroTranslator(Astro.currentLocale, "family");
const currentPath = Astro.url.pathname;

const includedKeys = [
    "included_1",
    "included_2",
    "included_3",
    "included_4",
    "included_5",
];
---

<PageLayout currentPath={currentPath} title={t("meta_title")} description={t("meta_description")}>
    <FamilyHero />
    <FamilyWhatWeOffer />
    <Techniques />
    <Testimonials category="family" />
    <FamilyPricing />
    <WhatsIncluded
        translationNamespace="family"
        includedKeys={includedKeys}
        emoji="🧑‍🧑‍🧒‍🧒"
    />
    <GiftCard translationNamespace="family" />
    <ExperienceSteps />
    <Gallery />
    <OurTeam />
    <Contact />
</PageLayout>
