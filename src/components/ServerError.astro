---
import SimpleLayout from "../layouts/SimpleLayout.astro";
import {
    getPageTranslations,
    getLocalizedPath,
    type Language,
} from "../utils/i18n";

interface Props {
    lang: Language;
}

const { lang } = Astro.props;
const translations = getPageTranslations(lang, "serverError");
const homeHref = getLocalizedPath("/", lang);
---

<SimpleLayout title={translations.title} homeHref={homeHref}>
    <h1>{translations.heading}</h1>
    <p>{translations.message}</p>
    <p class="contact-message">{translations.contactMessage}</p>
    <a href={homeHref} class="home-link">{translations.homeLink}</a>
</SimpleLayout>

<style>
    .contact-message {
        margin-bottom: 2rem;
    }
</style>
