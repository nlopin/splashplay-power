---
import { createAstroTranslator } from "../utils/i18n";
import PageLayout from "../layouts/PageLayout.astro";

import CouplesHero from "./sections/CouplesHero.astro";
import WhatWeOffer from "./sections/WhatWeOffer.astro";
import Testimonials from "./sections/Testimonials.astro";
import CouplesPricing from "./sections/CouplesPricing.astro";
import WhatsIncluded from "./sections/WhatsIncluded.astro";
import GiftCard from "./sections/GiftCards.astro";
import ExperienceSteps from "./sections/ExperienceSteps.astro";
import Gallery from "./sections/Gallery.astro";
import OurTeam from "./sections/OurTeam.astro";
import Faq from "./sections/Faq.astro";
import Contact from "./sections/Contact.astro";

const t = createAstroTranslator(Astro.currentLocale, "couples");
const currentPath = Astro.url.pathname;

const includedKeys = [
    "included_1",
    "included_2",
    "included_3",
    "included_4",
    "included_5",
];
---

<PageLayout currentPath={currentPath} title={t("meta_title")} description={t("meta_description")}>
    <CouplesHero />
    <WhatWeOffer variant="couples" />
    <Testimonials category="couples" />
    <CouplesPricing />
    <WhatsIncluded
        translationNamespace="couples"
        includedKeys={includedKeys}
        emoji="🥰"
    />
    <GiftCard translationNamespace="couples" />
    <ExperienceSteps />
    <Gallery />
    <OurTeam />
    <Faq variant="couples" />
    <Contact />
</PageLayout>
