---
import { createAstroTranslator } from "../utils/i18n";
import PageLayout from "../layouts/PageLayout.astro";

import FriendsHero from "./sections/FriendsHero.astro";
import FriendsWhatWeOffer from "./sections/FriendsWhatWeOffer.astro";
import Techniques from "./sections/Techniques.astro";
import Testimonials from "./sections/Testimonials.astro";
import FriendsPricing from "./sections/FriendsPricing.astro";
import GiftCard from "./sections/GiftCards.astro";
import ExperienceSteps from "./sections/ExperienceSteps.astro";
import Gallery from "./sections/Gallery.astro";
import OurTeam from "./sections/OurTeam.astro";
import Contact from "./sections/Contact.astro";
import WhatsIncluded from "./sections/WhatsIncluded.astro";

const t = createAstroTranslator(Astro.currentLocale, "friends");
const currentPath = Astro.url.pathname;
const includedKeys = [
    "included_1",
    "included_2",
    "included_3",
    "included_4",
    "included_5",
];
---

<PageLayout currentPath={currentPath} title={t("meta_title")} description={t("meta_description")}>
    <FriendsHero />
    <FriendsWhatWeOffer />
    <Techniques />
    <Testimonials category="friends" />
    <FriendsPricing />
    <WhatsIncluded translationNamespace="friends" includedKeys={includedKeys} />
    <GiftCard />
    <ExperienceSteps />
    <Gallery />
    <OurTeam />
    <Contact />
</PageLayout>
